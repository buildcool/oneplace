{
  "name": "oneplace",
  "version": "1.0.0",
  "private": true,
  "description": "Download video, audio, photos and thumbnails from almost any site, on your phone, with no servers.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "node node_modules/vitest/vitest.mjs run",
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build && node scripts/gen-presets.ts && node scripts/build-inject.ts",
    "typecheck": "node node_modules/typescript/bin/tsc",
    "live": "node scripts/live.ts",
    "cap": "node node_modules/@capacitor/cli/bin/capacitor"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
